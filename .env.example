# Kopier denne filen til .env og fyll inn verdiene.

# Database. Bruk lange, tilfeldige passord.
DB_PASSWORD=bytt-meg
DB_ROOT_PASSWORD=bytt-meg-ogsa

# Første komitémedlem. Opprettes automatisk når databasen er tom.
# Logg inn og bytt passord etterpå.
ADMIN_NAME=Johannes
ADMIN_EMAIL=deg@eksempel.no
ADMIN_PASSWORD=bytt-meg-ved-forste-innlogging

# E-post (for «glemt passord» og invitasjoner). Brevo: Transactional > Email > Settings > SMTP.
# MAIL_FROM må være en avsender eller et domene du har verifisert i Brevo.
SITE_URL=https://høstmessa.no
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Høstmessa

# Fra Cloudflare: Zero Trust > Networks > Tunnels > din tunnel > token.
CLOUDFLARE_TUNNEL_TOKEN=

# Informasjon om årets messe. Brukes til komiteen har lagret messeinfo på komitésiden.
MESSE_AAR=2026
MESSE_DATO=Lørdag 7. november
MESSE_TID=09:00
MESSE_STED=Sparebanken Norge-hallen, 4520 Lindesnes
MESSE_ADRESSE=Peder Claussøns vei 3, 4520 Sør-Audnedal
AUKSJON_TID=10:00
VAREFRIST=4. november
KONTAKT=messekomiteen
